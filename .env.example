# Copy to `.env` (gitignored) and fill in. Both Next.js and Prisma read `.env`.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Database (Postgres / Supabase) -----------------------------------------
# Pooled connection (pgbouncer, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Google Maps / Places ---------------------------------------------------
# Browser key (restricted to your domains) for Maps JS + Places autocomplete.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-browser-key"
# Server key (IP-restricted) for geocoding during the seed import (Phase 1).
GOOGLE_MAPS_SERVER_API_KEY="your-maps-server-key"
